{
  // Typecheck-only project for `tests/` — see packages/core/tsconfig.tests.json.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "types": ["node"],
    "paths": {
      "@kavo/core": ["../../packages/core/src/index.ts"],
      "@kavo/typeorm": ["../../packages/orms/typeorm/src/index.ts"],
      "@kavo/nest": ["../../packages/frameworks/nest/src/index.ts"],
      "@kavo/sse": ["../../packages/realtime/sse/src/index.ts"]
    }
  },
  "include": ["tests"]
}
