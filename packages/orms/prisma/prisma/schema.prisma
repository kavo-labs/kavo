// Test-fixture schema for @kavo/prisma's own test suite — mirrors the
// entities @kavo/typeorm declares inline (via decorators) per spec file.
// Prisma has no equivalent of "define an entity inline in a test file", so
// every fixture model used across tests/*.spec.ts lives in this one schema,
// generating one shared PrismaClient the test files reuse.
//
// `pnpm generate` pushes this schema to `template.db`, which no test opens:
// `tests/support/client.ts` copies it per client, so parallel spec files never
// contend for one SQLite file (issue #101).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── adapter.spec.ts ─────────────────────────────────────────────────────

enum Role {
  ADMIN
  MEMBER
}

model Author {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  age       Int
  status    String   @default("active")
  bio       String?
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  books     Book[]
}

model Book {
  id       Int     @id @default(autoincrement())
  title    String
  authorId Int?
  author   Author? @relation(fields: [authorId], references: [id])
}

// ── includes.spec.ts ────────────────────────────────────────────────────

model Blog {
  id       Int       @id @default(autoincrement())
  name     String
  articles Article[]
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  blogId    Int?
  blog      Blog?    @relation(fields: [blogId], references: [id])
  notes     Note[]
  deletedAt DateTime?
}

model Note {
  id        Int      @id @default(autoincrement())
  body      String
  articleId Int?
  article   Article? @relation(fields: [articleId], references: [id])
}

// ── soft-delete.spec.ts ─────────────────────────────────────────────────

model Ticket {
  id        Int       @id @default(autoincrement())
  reference String    @unique
  title     String
  deletedAt DateTime?
}

model Invoice {
  id         Int       @id @default(autoincrement())
  number     String
  archivedAt DateTime?
}

model Coupon {
  code      String    @id
  label     String
  retiredAt DateTime?
}

// ── cursor-pagination.spec.ts ───────────────────────────────────────────

model Post {
  id        Int       @id @default(autoincrement())
  title     String
  score     Int
  status    String
  createdAt DateTime
  deletedAt DateTime?
  comments  Comment[]
}

model Comment {
  id     Int   @id @default(autoincrement())
  body   String
  postId Int?
  post   Post? @relation(fields: [postId], references: [id])
}

// ── database-isolation.spec.ts ──────────────────────────────────────────

model Scratch {
  id    Int    @id @default(autoincrement())
  label String
}
