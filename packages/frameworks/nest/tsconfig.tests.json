{
  // Typecheck-only project for `tests/` — see packages/core/tsconfig.tests.json.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "types": ["node"],
    "paths": {
      "@kavo/core": ["../../core/src/index.ts"],
      "@kavo/graphql": ["../../protocols/graphql/src/index.ts"],
      "@kavo/mcp": ["../../protocols/mcp/src/index.ts"],
      "@kavo/nest": ["./src/index.ts"],
      "kavo-security-testkit": ["../../../tools/security-testkit/src/index.ts"]
    }
  },
  "include": ["tests"]
}
